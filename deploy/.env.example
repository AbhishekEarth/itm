# Production .env — copy to /opt/itmgoi/.env on the VPS and lock to 600.
# All secrets here MUST be unique to this deployment.

# ── App
APP_NAME=ITM Gwalior API
ENV=production
DEBUG=false
API_PREFIX=/api
TZ=Asia/Kolkata
FRONTEND_ORIGINS=https://itmgoi.in,https://www.itmgoi.in

# ── Postgres (used by docker-compose AND by app)
POSTGRES_USER=itm
POSTGRES_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_STRING
POSTGRES_DB=itm
DATABASE_URL=postgresql+psycopg://itm:CHANGE_ME_TO_A_LONG_RANDOM_STRING@db:5432/itm
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# ── Redis
REDIS_URL=redis://redis:6379/0

# ── Security
# Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME_TO_A_48_CHAR_RANDOM_STRING
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=14
PASSWORD_MIN_LENGTH=10
LOGIN_LOCKOUT_THRESHOLD=5
LOGIN_LOCKOUT_WINDOW_MIN=15

# Default super-admin (only used on a virgin DB; rotate after first login)
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_EMAIL=admin@itmgoi.in
DEFAULT_ADMIN_PASSWORD=CHANGE_ME_BEFORE_GOING_LIVE

# ── Object storage (Cloudflare R2 / Hostinger Object Storage / AWS S3)
STORAGE_BACKEND=s3
UPLOAD_DIR=/var/itm/uploads          # fallback path; ignored by app when STORAGE_BACKEND=s3
PUBLIC_MEDIA_BASE_URL=https://cdn.itmgoi.in
MAX_UPLOAD_MB_IMAGE=10
MAX_UPLOAD_MB_PDF=25
MAX_UPLOAD_MB_VIDEO=200

S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=itm-media
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
S3_PUBLIC_BASE_URL=https://cdn.itmgoi.in

# ── Backup target (same R2 account or a separate bucket)
S3_BACKUP_BUCKET=itm-backups
GPG_RECIPIENT=ops@itmgoi.in           # backup encryption key id; gpg --import the public key on the VPS

# ── SMTP (Hostinger or any provider)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_USER=no-reply@itmgoi.in
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM=no-reply@itmgoi.in
SMTP_USE_TLS=true

# ── Observability
SENTRY_DSN=
LOG_LEVEL=INFO

# ── Rate limits (slowapi)
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_FORMS=5/minute

# Tag the image deployed by CI (set automatically by GitHub Actions on each release)
IMAGE_TAG=latest
