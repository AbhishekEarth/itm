# Frontend production env — set these in the Vercel project Settings → Environment Variables.
# NB: VITE_API_URL is OPTIONAL when /api is rewritten by vercel.json (see same-origin proxy);
# leaving it empty makes the SPA call same-origin /api paths, which Vercel rewrites to the HF Space.

# Same-origin (uses the rewrites in vercel.json — RECOMMENDED, avoids CORS headache):
# VITE_API_URL=

# Direct (skips the Vercel rewrite — set if you want the browser to call HF directly,
# in which case the HF Space must include https://<your-vercel>.vercel.app in FRONTEND_ORIGINS):
# VITE_API_URL=https://YOUR-HF-USERNAME-itmgoi-api.hf.space/api
