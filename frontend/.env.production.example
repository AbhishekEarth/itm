# ╔══════════════════════════════════════════════════════════════════╗
# ║  Frontend — PRODUCTION env (Vercel)                              ║
# ║                                                                  ║
# ║  Set these in:  Vercel dashboard → Project → Settings →          ║
# ║                  Environment Variables (scope: Production)        ║
# ║                                                                  ║
# ║  Do NOT commit a real .env.production — the .gitignore blocks it.║
# ╚══════════════════════════════════════════════════════════════════╝

# ── API base URL ────────────────────────────────────────────────
# RECOMMENDED: leave empty. The SPA calls same-origin /api/* paths,
# which vercel.json rewrites to Cloud Run. This avoids CORS entirely
# because the browser only sees Vercel's domain.
#
#   VITE_API_URL=
#
# Only set this if you want the SPA to bypass Vercel's rewrites and
# hit Cloud Run directly. In that case you MUST add the Vercel +
# custom domain to FRONTEND_ORIGINS on the backend, AND update
# vercel.json so /api isn't rewritten anymore.
#
# Direct mode example:
#   VITE_API_URL=https://api.itmgoi.in/api
VITE_API_URL=

# ── Build-time site URL (for SEO meta tags, sitemap, og:url) ────
# Use your custom domain once it's wired up, or the Vercel URL until then.
VITE_PUBLIC_SITE_URL=<PASTE_CUSTOM_DOMAIN_OR_VERCEL_URL>
