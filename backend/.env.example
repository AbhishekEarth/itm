# Copy to .env and fill in real values before deploying.

APP_NAME=ITM GOI API
DEBUG=false

# For production switch to: postgresql+psycopg2://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./itm.db

# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-this-with-a-long-random-string

CORS_ORIGINS=["http://localhost:5173","https://your-production-domain.com"]
