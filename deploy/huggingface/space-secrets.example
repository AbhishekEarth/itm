# Paste each KEY=value into HF Space → Settings → "Variables and secrets".
# Use "Secrets" for anything sensitive (JWT_SECRET, DEFAULT_ADMIN_PASSWORD, SMTP_PASSWORD).
# Use "Variables" for things that don't need to be secret (FRONTEND_ORIGINS).

# ── REQUIRED secrets ────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_48_RANDOM_CHARS
DEFAULT_ADMIN_PASSWORD=CHANGE_ME_BEFORE_GOING_LIVE

# ── REQUIRED variable ───────────────────────────────────────────────
# Your Vercel deployment URL(s). Comma-separated, no trailing slash.
FRONTEND_ORIGINS=https://itmgoi.vercel.app

# ── Optional: SMTP for admission-lead notifications ─────────────────
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_USER=no-reply@itmgoi.in
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM=no-reply@itmgoi.in

# ── Optional: external Postgres (avoids ephemeral SQLite resets) ────
# Spin up Neon / Supabase / Railway → paste the connection string here.
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/dbname

# ── Optional: external object storage (avoids ephemeral uploads) ────
# STORAGE_BACKEND=s3
# S3_ENDPOINT_URL=https://<account>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=itm-media
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_PUBLIC_BASE_URL=https://cdn.itmgoi.in
