# ── App ──────────────────────────────────────────────────────────
APP_NAME=ITM Gwalior API
ENV=development                         # development | staging | production
DEBUG=true
API_PREFIX=/api
TZ=Asia/Kolkata

# ── HTTP / CORS ──────────────────────────────────────────────────
# Comma-separated list of allowed origins (NO wildcards in production)
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Database ─────────────────────────────────────────────────────
# For local docker compose: postgresql+psycopg://itm:itm@db:5432/itm
# For local non-docker: postgresql+psycopg://itm:itm@localhost:5432/itm
# For dev SQLite fallback: sqlite:///./itmgoi.db
DATABASE_URL=postgresql+psycopg://itm:itm@localhost:5432/itm
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# ── Redis (cache + rate limit) ───────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Security ─────────────────────────────────────────────────────
# Generate with:  python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-48-char-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=14
PASSWORD_MIN_LENGTH=8
LOGIN_LOCKOUT_THRESHOLD=5
LOGIN_LOCKOUT_WINDOW_MIN=15

# ── Default super-admin (used by scripts/seed.py on first run only) ──
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_EMAIL=admin@itmgoi.in
DEFAULT_ADMIN_PASSWORD=admin123          # CHANGE on first login

# ── File storage ─────────────────────────────────────────────────
# STORAGE_BACKEND=local | s3
STORAGE_BACKEND=local
UPLOAD_DIR=./uploads
PUBLIC_MEDIA_BASE_URL=/uploads           # served by FastAPI in dev; by nginx in prod
MAX_UPLOAD_MB_IMAGE=10
MAX_UPLOAD_MB_PDF=25
MAX_UPLOAD_MB_VIDEO=200

# ── S3 / R2 (only used if STORAGE_BACKEND=s3) ────────────────────
S3_ENDPOINT_URL=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_BASE_URL=                      # CDN URL prefix, e.g. https://cdn.itmgoi.in

# ── SMTP (form notifications) ────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@itmgoi.in
SMTP_USE_TLS=true

# ── Observability ────────────────────────────────────────────────
SENTRY_DSN=
LOG_LEVEL=INFO

# ── Rate limiting ────────────────────────────────────────────────
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_FORMS=5/minute
