# ╔══════════════════════════════════════════════════════════════════╗
# ║  ITM Gwalior — PRODUCTION env (Cloud Run, Mumbai region)         ║
# ║                                                                  ║
# ║  Copy this to `.env.production`, fill in every <PASTE_…> below,  ║
# ║  then set the same vars in Cloud Run → Service → Variables.      ║
# ║                                                                  ║
# ║  Never commit `.env.production`. The .gitignore already blocks   ║
# ║  it; double-check with `git status` before pushing.              ║
# ╚══════════════════════════════════════════════════════════════════╝

# ── App ──────────────────────────────────────────────────────────
APP_NAME=ITM Gwalior API
ENV=production
DEBUG=false
API_PREFIX=/api
TZ=Asia/Kolkata
LOG_LEVEL=INFO

# ── HTTP / CORS ──────────────────────────────────────────────────
# Comma-separated. Add every domain the browser will load the SPA from:
#   - your Vercel preview URL (https://itm-production-frontend.vercel.app)
#   - your custom domain (https://itmgoi.in, https://www.itmgoi.in)
# No wildcards in production — validator will reject them.
FRONTEND_ORIGINS=<PASTE_VERCEL_URL>,<PASTE_CUSTOM_DOMAIN>,<PASTE_WWW_DOMAIN>

# ╔══ DATABASE — Supabase Postgres (Mumbai, ap-south-1) ═══════════╗
# Use the **TRANSACTION POOLER** URL (port 6543) for Cloud Run runtime.
# Get it from: Supabase Dashboard → Project Settings → Database →
#              Connection string → Transaction
#
# Format:
#   postgresql+psycopg://postgres.<project-ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
#
# IMPORTANT: keep the `+psycopg` driver tag — SQLAlchemy needs it.
DATABASE_URL=<PASTE_SUPABASE_POOLER_URL>

# Pool sizing for Cloud Run (each instance opens its own pool).
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# ── Redis (optional in prod; leave empty to disable cache) ───────
# If you add Upstash / Memorystore later, paste the URL here.
REDIS_URL=

# ── Security ─────────────────────────────────────────────────────
# Generate ONCE with:  python -c "import secrets;print(secrets.token_urlsafe(48))"
# Rotating this logs out every user — only rotate on incident.
JWT_SECRET=<PASTE_48_CHAR_RANDOM_STRING>
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=14
PASSWORD_MIN_LENGTH=10
LOGIN_LOCKOUT_THRESHOLD=5
LOGIN_LOCKOUT_WINDOW_MIN=15

# ── Super-admin seed (used ONLY on first migration) ──────────────
# Change the password on first login. Anyone who reads this env var
# can log in as super-admin until then.
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_EMAIL=<PASTE_ADMIN_EMAIL>
DEFAULT_ADMIN_PASSWORD=<PASTE_TEMP_ADMIN_PASSWORD>

# ╔══ FILE STORAGE — Cloudflare R2 ════════════════════════════════╗
# Keep STORAGE_BACKEND=s3 — boto3 talks to R2 via the S3 protocol.
STORAGE_BACKEND=s3
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB_IMAGE=10
MAX_UPLOAD_MB_PDF=25
MAX_UPLOAD_MB_VIDEO=200

# Endpoint: dash.cloudflare.com → R2 → bucket → Settings → S3 API
#   Format: https://<account-id>.r2.cloudflarestorage.com
S3_ENDPOINT_URL=<PASTE_R2_ENDPOINT>

# R2 always uses region "auto" — leave as-is.
S3_REGION=auto

# Bucket name you created (e.g. itmgoi-prod-media).
S3_BUCKET=<PASTE_R2_BUCKET_NAME>

# API token: R2 main page → "Manage R2 API Tokens" → Create token
#            Permission: Object Read & Write
S3_ACCESS_KEY=<PASTE_R2_ACCESS_KEY_ID>
S3_SECRET_KEY=<PASTE_R2_SECRET_ACCESS_KEY>

# Public URL prefix — what the browser uses to load uploaded files.
# Prefer a custom domain (https://cdn.itmgoi.in), fall back to
# the R2.dev subdomain (https://pub-<hash>.r2.dev) for testing.
S3_PUBLIC_BASE_URL=<PASTE_R2_PUBLIC_URL>

# Also expose the public URL to the SPA so old /uploads/* paths
# still resolve. PUBLIC_MEDIA_BASE_URL is read by the same code
# path as S3_PUBLIC_BASE_URL — keeping them identical is safest.
PUBLIC_MEDIA_BASE_URL=<PASTE_R2_PUBLIC_URL>

# ╔══ AI AGENT — NVIDIA NIM + ChromaDB ════════════════════════════╗
# Get the key from: build.nvidia.com → Profile → API Keys
NVIDIA_API_KEY=<PASTE_NVIDIA_API_KEY>
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.1-70b-instruct
NVIDIA_MAX_TOKENS=2048
NVIDIA_TEMPERATURE=0.1
NVIDIA_TOP_P=0.9

# ChromaDB persistence path — on Cloud Run this must be /tmp/chroma_data
# (only /tmp is writable on the default Cloud Run filesystem).
# If you later want persistent vectors across cold starts, mount a
# Cloud Storage FUSE volume or move to a hosted vector DB.
CHROMA_PERSIST_DIR=/tmp/chroma_data
CHROMA_COLLECTION_NAME=itm_gwalior_docs
EMBEDDING_MODEL=all-MiniLM-L6-v2
CHUNK_SIZE=512
CHUNK_OVERLAP=64
RETRIEVAL_K=4

# Scraper websites — primary site = your Vercel URL.
# Once the custom domain is live, swap to https://itmgoi.in.
PRIMARY_WEBSITE=<PASTE_PRIMARY_WEBSITE_URL>
UNIVERSITY_WEBSITE=https://www.itmuniversity.ac.in
LMS_URL=https://lms.itmgoi.in
ERP_URL=https://mis.itmuniversity.ac.in/itmzone
IDEAPAD_URL=https://ideapad.co.in
SCRAPE_INTERVAL_HOURS=24
SCRAPE_TIMEOUT_SECONDS=30
MAX_SCRAPE_PAGES=100

# ── SMTP (form notifications) ────────────────────────────────────
# Leave blank to disable email. SendGrid / Mailgun / Gmail SMTP all work.
SMTP_HOST=<PASTE_SMTP_HOST>
SMTP_PORT=587
SMTP_USER=<PASTE_SMTP_USER>
SMTP_PASSWORD=<PASTE_SMTP_PASSWORD>
SMTP_FROM=no-reply@itmgoi.in
SMTP_USE_TLS=true

# ── Observability ────────────────────────────────────────────────
# Sign up at sentry.io, create a Python project, paste the DSN.
# Empty = disabled.
SENTRY_DSN=<PASTE_SENTRY_DSN_OR_LEAVE_EMPTY>

# ── Rate limiting ────────────────────────────────────────────────
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_FORMS=5/minute
